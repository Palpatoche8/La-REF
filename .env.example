# ── Public ──────────────────────────────────────────────────────────────────
# URL du flux radio en direct (bouton "Écouter en direct")
NEXT_PUBLIC_STREAM_URL=https://stream.laref.fr/live

# Set to "1" when deploying to Vercel (automatically injected via vercel.json)
NEXT_PUBLIC_IS_VERCEL=

# ── Admin ────────────────────────────────────────────────────────────────────
# Mot de passe de l'interface d'administration (/admin)
ADMIN_PASSWORD=changeme

# ── Vercel Blob (audio file storage — production only) ───────────────────────
# Created automatically in your Vercel project dashboard → Storage → Blob
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# ── Vercel KV / Redis (episodes metadata — production only) ─────────────────
# Created automatically in your Vercel project dashboard → Storage → KV
# https://vercel.com/docs/storage/vercel-kv
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
