# ── Public ──────────────────────────────────────────────────────────────────
# URL du flux radio en direct (bouton "Écouter en direct")
NEXT_PUBLIC_STREAM_URL=https://fr.welove.radio/radio/la-ref/

# Set to "1" when deploying to Vercel (automatically injected via vercel.json)
NEXT_PUBLIC_IS_VERCEL=1

# ── Admin ────────────────────────────────────────────────────────────────────
# Mot de passe de l'interface d'administration (/admin)
ADMIN_PASSWORD=JTILJ_2026

# Email Google du compte administrateur (doit correspondre à un compte OAuth connecté)
# Exposé côté client pour afficher/masquer le lien "Admin" dans la navbar
NEXT_PUBLIC_ADMIN_EMAIL=scheepers.thomas@outlook.com
ADMIN_EMAIL=scheepers.thomas@outlook.com

# ── Auth OAuth (NextAuth.js) ─────────────────────────────────────────────────
# Clé secrète pour signer les JWT de session — générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32

# URL de base du site (sans slash final)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — créer sur https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Discord OAuth (optionnel) — créer sur https://discord.com/developers/applications
# Laisser vide pour désactiver la connexion Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Vercel Blob (audio file storage — production only) ───────────────────────
# Created automatically in your Vercel project dashboard → Storage → Blob
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_2M9TmDpgcgpIXFDj_WoIHknTJ1i3lVAX3PNhxM9F513o5wa

# ── Vercel KV / Redis (episodes metadata — production only) ─────────────────
# Created automatically in your Vercel project dashboard → Storage → KV
# https://vercel.com/docs/storage/vercel-kv
KV_REST_API_URL=https://proven-oriole-88086.upstash.io
KV_REST_API_TOKEN=gQAAAAAAAVgWAAIncDExMGM2OWQ3ODhiNjQ0ZDYyODQ4MzE0NGVhOWE4ZmEwOHAxODgwODY
